---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Andy.Lee",
  description = "Embedded / Linux / Android Engineer · TPM — Andy.Lee's personal site",
} = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogUrl = `${site}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} &mdash; Andy.Lee</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={`${title} — Andy.Lee`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {site && <meta property="og:url" content={ogUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Set theme before paint to avoid flash (dark by default; respects saved choice / OS)
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <style is:global>
      :root {
        /* palette */
        --bg: #0a0e14;
        --fg: #b3b1ad;
        --c-cyan: #00d4ff;
        --c-cyan-bright: #66e6ff;
        --c-green: #4caf50;
        --c-blue: #42a5f5;
        --c-magenta: #ce93d8;
        --c-yellow: #e6db74;
        --c-dim: #626a73;
        --rule: #1e2329;
        --scroll-thumb: #2d343a;
        /* type scale */
        --fs-sm: .85rem;
        --fs-xs: .8rem;
      }
      /* Light theme — terminal palette adjusted for contrast on paper */
      :root[data-theme="light"] {
        --bg: #f7f8fa;
        --fg: #2b3138;
        --c-cyan: #0e7490;
        --c-cyan-bright: #0891b2;
        --c-green: #1a7f37;
        --c-blue: #0550ae;
        --c-magenta: #8250df;
        --c-yellow: #9a6700;
        --c-dim: #6e7781;
        --rule: #d0d7de;
        --scroll-thumb: #c3cad1;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; scroll-behavior: smooth; }
      body {
        font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.7;
        min-height: 100vh;
        transition: background .25s ease, color .25s ease;
      }
      a { color: var(--c-cyan); text-decoration: none; transition: color .2s; }
      a:hover { color: var(--c-cyan-bright); text-decoration: underline; }
      ::selection { background: #00d4ff33; }

      /* Theme toggle button */
      .theme-toggle {
        position: fixed; top: .8rem; right: .8rem; z-index: 50;
        font-family: inherit; font-size: .95rem; line-height: 1;
        background: transparent; color: var(--c-dim);
        border: 1px solid var(--rule); border-radius: 6px;
        padding: .3rem .55rem; cursor: pointer;
        transition: color .2s, border-color .2s;
      }
      .theme-toggle:hover { color: var(--c-cyan); border-color: var(--c-cyan); }
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--scroll-thumb); border-radius: 3px; }

      /* ── Shared terminal utilities (used across all pages) ── */
      .terminal { padding: 2rem 1rem; max-width: 820px; margin: 0 auto; }
      .container { animation: fadeIn .8s ease-out; }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
      .gap { height: .6rem; }

      /* semantic colors */
      .dim { color: var(--c-dim); }
      .cyan { color: var(--c-cyan); }
      .green { color: var(--c-green); }
      .blue { color: var(--c-blue); }
      .magenta { color: var(--c-magenta); }
      .yellow { color: var(--c-yellow); }

      /* prompt + command lines */
      .cmd-line { line-height: 2; }
      .prompt { user-select: none; }
      .cmd { color: var(--c-yellow); }

      /* output blocks + shared page chrome */
      .output { margin: .2rem 0 .4rem 1.2rem; }
      .section-title { font-size: 1rem; margin: 1rem 0 .6rem; font-weight: 500; }
      .nav-back { margin-top: 2rem; font-size: .9rem; }

      @media (max-width: 600px) {
        .terminal { padding: 1rem .6rem; font-size: .85rem; }
      }
    </style>
  </head>
  <body>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" title="切换深色 / 浅色">
      <span class="theme-icon">☀</span>
    </button>
    <slot />
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var icon = btn && btn.querySelector('.theme-icon');
        function sync() {
          var t = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          if (icon) icon.textContent = t === 'dark' ? '☀' : '☾';
        }
        sync();
        if (btn) btn.addEventListener('click', function () {
          var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          var next = cur === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
