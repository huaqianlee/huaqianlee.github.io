---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Andy.Lee">
  <!-- Star field background -->
  <div class="stars" aria-hidden="true"></div>
  <div class="stars2" aria-hidden="true"></div>
  <div class="stars3" aria-hidden="true"></div>

  <main class="hero">
    <div class="content">
      <!-- Name -->
      <h1 class="name">
        <span class="name-glow">Andy</span><span class="name-dim">.</span><span class="name-glow name-last">Lee</span>
      </h1>

      <!-- Subtitle -->
      <p class="subtitle">Embedded Systems &amp; Linux Kernel Engineer</p>

      <!-- Divider -->
      <div class="divider">
        <span class="divider-dot">✦</span>
        <span class="divider-line"></span>
        <span class="divider-dot">✦</span>
      </div>

      <!-- Tagline -->
      <p class="tagline">
        Ten years building the software that runs on the edge —<br />
        from <span class="highlight">bootloaders</span> to
        <span class="highlight">battery management</span>,
        from <span class="highlight">Linux drivers</span> to
        <span class="highlight">Android systems</span>.
      </p>

      <!-- Navigation -->
      <nav class="nav">
        <a href="/about/" class="nav-link">
          <span class="nav-icon">⎔</span>
          <span class="nav-label">About</span>
        </a>
        <a href="/projects/" class="nav-link">
          <span class="nav-icon">✦</span>
          <span class="nav-label">Projects</span>
        </a>
        <a href="/blog/" class="nav-link">
          <span class="nav-icon">◈</span>
          <span class="nav-label">Blog</span>
        </a>
        <a href="https://github.com/huaqianlee" class="nav-link" target="_blank">
          <span class="nav-icon">⊞</span>
          <span class="nav-label">GitHub</span>
        </a>
      </nav>

      <!-- Recent -->
      <div class="recent">
        <p class="recent-heading">✦ recent writing</p>
        <div class="recent-links">
          <a href="/blog/2017/12/03/Android/Android-Linux-i2c-driver-arch/">Android/Linux I2C Driver Architecture</a>
          <span class="recent-dot">·</span>
          <a href="/blog/2015/05/30/Android/Android电源管理架构/">Android Power Management</a>
          <span class="recent-dot">·</span>
          <a href="/blog/2015/08/21/Linux/深入理解Linux启动过程/">Linux Boot Process</a>
          <span class="recent-dot">·</span>
          <a href="/blog/2019/08/31/Linux/Process-and-thread-in-linux/">Process &amp; Thread in Linux</a>
        </div>
      </div>

      <!-- Footer -->
      <footer class="footer">
        <a href="mailto:huaqianlee@gmail.com">email</a>
        <span class="footer-sep">/</span>
        <a href="https://github.com/huaqianlee">github</a>
        <span class="footer-sep">/</span>
        <span class="location">shenzhen</span>
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  /* ===== Star field (pure CSS) ===== */
  .stars, .stars2, .stars3 {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .stars {
    background: transparent;
    box-shadow:
      124px 58px 1px rgba(255,255,255,0.15), 432px 180px 1px rgba(255,255,255,0.08),
      67px 432px 1px rgba(255,255,255,0.12), 876px 234px 1px rgba(255,255,255,0.06),
      345px 654px 1px rgba(255,255,255,0.14), 123px 789px 1px rgba(255,255,255,0.09),
      567px 123px 1px rgba(255,255,255,0.11), 890px 456px 1px rgba(255,255,255,0.07),
      234px 901px 1px rgba(255,255,255,0.13), 678px 345px 1px rgba(255,255,255,0.08);
    animation: twinkle 4s ease-in-out infinite;
  }

  .stars2 {
    background: transparent;
    box-shadow:
      150px 100px 2px rgba(255,255,255,0.2), 400px 300px 2px rgba(255,255,255,0.15),
      700px 500px 2px rgba(255,255,255,0.18), 200px 600px 2px rgba(255,255,255,0.12),
      800px 200px 2px rgba(255,255,255,0.22), 100px 700px 2px rgba(255,255,255,0.14),
      500px 100px 2px rgba(255,255,255,0.19), 900px 400px 2px rgba(255,255,255,0.16),
      300px 800px 2px rgba(255,255,255,0.13), 600px 900px 2px rgba(255,255,255,0.2);
    animation: twinkle 6s ease-in-out infinite reverse;
  }

  .stars3 {
    background: transparent;
    box-shadow:
      250px 200px 3px rgba(255,255,255,0.25), 600px 400px 3px rgba(255,255,255,0.2),
      100px 500px 3px rgba(255,255,255,0.22), 800px 700px 3px rgba(255,255,255,0.18),
      400px 100px 3px rgba(255,255,255,0.28), 900px 800px 3px rgba(255,255,255,0.24),
      150px 900px 3px rgba(255,255,255,0.2), 700px 50px 3px rgba(255,255,255,0.26),
      350px 350px 3px rgba(0,212,255,0.15), 800px 600px 3px rgba(0,212,255,0.12);
    animation: twinkle 8s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }

  body {
    background: linear-gradient(135deg, #05080f 0%, #0a1628 40%, #0d1b3e 100%);
    min-height: 100vh;
  }

  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1.5rem;
  }

  .content {
    max-width: 640px;
    text-align: center;
  }

  .name {
    font-size: 3.5rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .name-glow {
    color: #fff;
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.3),
                 0 0 40px rgba(0, 212, 255, 0.15),
                 0 0 80px rgba(0, 212, 255, 0.08);
  }

  .name-dim { color: #2a3a5c; }
  .name-last { font-weight: 400; }

  .subtitle {
    font-size: 0.95rem;
    color: #4a6a9a;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .divider-line {
    display: block;
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
  }

  .divider-dot {
    color: rgba(0, 212, 255, 0.4);
    font-size: 0.6rem;
  }

  .tagline {
    font-size: 0.92rem;
    color: #7899c4;
    line-height: 1.9;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .highlight {
    color: rgba(0, 212, 255, 0.8);
    text-shadow: 0 0 12px rgba(0, 212, 255, 0.15);
  }

  .nav {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #7899c4;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .nav-link:hover {
    color: #fff;
    border-color: rgba(0, 212, 255, 0.2);
    background: rgba(0, 212, 255, 0.05);
    text-decoration: none;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.08);
    text-shadow: 0 0 8px rgba(0, 212, 255, 0.3);
  }

  .nav-icon { font-size: 1rem; opacity: 0.7; }

  .recent { margin-bottom: 2.5rem; }

  .recent-heading {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #2a4a6a;
    margin-bottom: 0.8rem;
  }

  .recent-links {
    font-size: 0.82rem;
    color: #4a6a9a;
    line-height: 2;
  }

  .recent-links a {
    color: #7899c4;
    text-decoration: none;
    transition: all 0.3s;
  }

  .recent-links a:hover {
    color: #fff;
    text-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
    text-decoration: none;
  }

  .recent-dot { color: #1a2a4a; margin: 0 0.4rem; }

  .footer {
    font-size: 0.8rem;
    color: #2a3a5c;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    align-items: center;
  }

  .footer a { color: #4a6a9a; text-decoration: none; transition: color 0.3s; }
  .footer a:hover { color: rgba(0, 212, 255, 0.6); }
  .footer-sep { color: #1a2a3a; }
  .location { color: #2a4a6a; }

  @media (max-width: 600px) {
    .name { font-size: 2.2rem; }
    .nav { gap: 0.8rem; }
    .nav-link { font-size: 0.82rem; padding: 0.3rem 0.6rem; }
    .recent-links { font-size: 0.78rem; }
    .hero { padding: 1.5rem 1rem; }
  }
</style>
