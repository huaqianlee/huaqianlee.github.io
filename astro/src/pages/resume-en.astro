---
import { getEntry } from 'astro:content';
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Resume from '../components/Resume.astro';

const entry = await getEntry('resume', 'en');
if (!entry) throw new Error('Resume content "en" not found');
---

<ResumeLayout title="Andy Lee — Resume" lang="en">
  <Resume data={entry.data} lang="en" />
</ResumeLayout>
