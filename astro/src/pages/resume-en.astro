---
import Layout from '../layouts/Layout.astro';
---

<Layout title="resume-en">
  <main class="terminal">
    <div class="container">
      <div class="cmd-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cmd">open resume_en.html</span>
      </div>

      <div class="gap"></div>

      <div class="output">
        <p>Loading resume...</p>
        <p class="dim">If not redirected automatically, <a href="/resume_en.html">click here</a>.</p>
      </div>

      <div class="gap"></div>

      <div class="nav-back">
        <span class="dim">$ </span><a href="/">cd ~</a>
        <span class="dim"> | </span>
        <a href="/resume">中文简历 →</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  window.location.replace('/resume_en.html');
</script>

<style is:global>
  .nav-back { margin-top: 2rem; font-size: .9rem; }
</style>
