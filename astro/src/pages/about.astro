---
import Layout from '../layouts/Layout.astro';
---

<Layout title="about">
  <main class="terminal">
    <div class="container">
      <div class="cmd-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cmd">cat about.md</span>
      </div>

      <div class="gap"></div>

      <div class="output">
        <h1 class="section-title"><span class="cyan">#</span> About Me</h1>

        <p class="desc">
          Embedded Systems / Linux Kernel Engineer with <span class="highlight">10+ years</span> of experience in
          Android/Linux/Embedded development, including 2 years as Manager and TPM.
          Proficient in <span class="highlight">C/C++</span>, Java, Python, Shell.
          Experienced on Qualcomm (MSM8909/8916/8974/SDM450/SM6125/SM8250) and MTK (MTK6570/6739) platforms.
        </p>

        <div class="gap"></div>

        <h2 class="section-title"><span class="green">##</span> Skills</h2>
        <div class="skills-grid">
          <div class="skill-cat">
            <div class="skill-title">Languages</div>
            <div class="skill-items">C<span class="dim">†</span> · C++<span class="dim">†</span> · Java<span class="dim">†</span> · Python · Shell<span class="dim">†</span></div>
          </div>
          <div class="skill-cat">
            <div class="skill-title">Kernel &amp; BSP</div>
            <div class="skill-items">Linux Drivers · Device Tree · Bootloader · Power Management · Performance · Thermal</div>
          </div>
          <div class="skill-cat">
            <div class="skill-title">Android</div>
            <div class="skill-items">AOSP · HAL · BMS · Charger · USB · SELinux · Camera · Display</div>
          </div>
          <div class="skill-cat">
            <div class="skill-title">Tools</div>
            <div class="skill-items">Git<span class="dim">†</span> · Vim<span class="dim">†</span> · Docker · Yocto · Android Studio · Ubuntu<span class="dim">†</span></div>
          </div>
        </div>
        <p class="dim footnote"><span class="dim">†</span> frequently used</p>

        <div class="gap"></div>

        <h2 class="section-title"><span class="magenta">###</span> Work Experience</h2>
        <div class="timeline">
          <div class="exp-item">
            <div class="exp-year"><span class="dim">[2018 - ]</span></div>
            <div class="exp-detail">
              <div class="exp-company">Thunder Software Technology — <span class="dim">Senior Engineer / TPM / Team Leader</span></div>
              <div class="exp-desc">Built IoT Camera team (9 members), delivered European/American projects, developed vehicle Camera POC (SM6125+Ubuntu), refactored Android Display HAL for SPI screen, managed pre-sales to after-sales.</div>
            </div>
          </div>
          <div class="exp-item">
            <div class="exp-year"><span class="dim">[2017 - 2018]</span></div>
            <div class="exp-detail">
              <div class="exp-company">EASTAEON Technology — <span class="dim">BSP Engineer</span></div>
              <div class="exp-desc">MTK platform (MTK6570/6739) BSP development — LCD, TP, Camera, Charger/Battery.</div>
            </div>
          </div>
          <div class="exp-item">
            <div class="exp-year"><span class="dim">[2014 - 2017]</span></div>
            <div class="exp-detail">
              <div class="exp-company">IDEA INTERNATIONAL — <span class="dim">Embedded Engineer</span></div>
              <div class="exp-desc">Qualcomm platform (MSM8916/8909/8974) driver development — power, charger, LCD, Camera. Drone BSP &amp; flight control on Linaro system — IMU, GPS, sensor bring-up.</div>
            </div>
          </div>
          <div class="exp-item">
            <div class="exp-year"><span class="dim">[2011 - 2013]</span></div>
            <div class="exp-detail">
              <div class="exp-company">Chengdu WXL Communication — <span class="dim">Embedded Developer</span></div>
              <div class="exp-desc">Samsung platform &amp; STM32 embedded development — schematic design, MCU programming, Linux porting.</div>
            </div>
          </div>
        </div>

        <div class="gap"></div>

        <h2 class="section-title"><span class="blue">####</span> Education</h2>
        <div class="edu-item">
          <span class="dim">[2008 - 2012]</span> Sichuan Technology and Business University
          <span class="dim">—</span> Electronic Information Engineering
          <span class="dim">·</span> Bachelor of Engineering
        </div>

        <div class="gap"></div>

        <h2 class="section-title"><span class="yellow">#####</span> Honors</h2>
        <ul class="honors-list">
          <li>"Craftsman" Award 2021</li>
          <li>National Electronic Design Contest — 2nd Prize (Sichuan) 2011</li>
          <li>National Electronic Design Contest — 3rd Prize 2011</li>
        </ul>

        <div class="gap"></div>

        <div class="nav-back">
          <span class="dim">$ </span><a href="/">cd ~</a>
          <span class="dim"> | </span>
          <a href="/resume">📄 resume</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* about-specific — shared utilities (.section-title/.nav-back/.yellow) live in Layout.astro */
  .desc { line-height: 1.9; max-width: 640px; }
  .highlight { color: var(--c-cyan); }
  .skills-grid { display: grid; gap: .8rem; }
  .skill-title { color: var(--c-yellow); font-size: .85rem; margin-bottom: .2rem; }
  .skill-items { color: var(--fg); font-size: .9rem; }
  .footnote { font-size: var(--fs-xs); margin-top: .3rem; }
  .timeline { margin: .4rem 0; display: flex; flex-direction: column; gap: .8rem; }
  .exp-item { display: flex; gap: 1rem; line-height: 1.7; }
  .exp-year { white-space: nowrap; min-width: 5rem; font-size: .9rem; padding-top: .1rem; }
  .exp-detail { color: var(--fg); }
  .exp-company { color: var(--c-yellow); font-size: .92rem; }
  .exp-desc { font-size: .88rem; margin-top: .15rem; }
  .edu-item { color: var(--fg); font-size: .9rem; line-height: 1.8; }
  .honors-list { color: var(--fg); font-size: .9rem; line-height: 1.9; padding-left: 1.2rem; }
  @media (max-width: 600px) {
    .exp-item { flex-direction: column; gap: .2rem; }
    .exp-year { min-width: auto; }
  }
</style>
