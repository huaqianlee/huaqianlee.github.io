---
import { getEntry } from 'astro:content';
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Resume from '../components/Resume.astro';

const entry = await getEntry('resume', 'cn');
if (!entry) throw new Error('Resume content "cn" not found');
---

<ResumeLayout title="李华乾 · Andy Lee — 简历" lang="zh-CN">
  <Resume data={entry.data} lang="cn" />
</ResumeLayout>
