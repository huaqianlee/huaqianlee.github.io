---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <main class="terminal">
    <div class="container">
      <!-- Boot sequence -->
      <div class="line boot">[  <span class="ok">OK</span>  ] Initializing kernel modules</div>
      <div class="line boot">[  <span class="ok">OK</span>  ] Mounting root filesystem</div>
      <div class="line boot">[  <span class="ok">OK</span>  ] Starting systemd-networkd</div>
      <div class="line boot">[  <span class="ok">OK</span>  ] Reached target Multi-User System</div>
      <div class="line boot dim">────────────────────────────────────────────────</div>

      <!-- cat about.md -->
      <div class="cmd-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cmd">cat about.md</span>
      </div>
      <div class="output">
        <pre class="ascii-name">
  ┌─────────────────────────────────────────────┐
  │  _          _           _    ___  _    _    │
  │ / \   _ __ | |_   _  __| |  / _ \| |  | |   │
  │/ _ \ | '_ \| | | | |/ _` | | | | | |  | |   │
  │/ ___ \| | | | | |_| | (_| | | |_| | |__| |   │
  │/_/   \_\_| |_|_|\__, |\__,_|  \___/ \____/    │
  │                 |___/                         │
  └─────────────────────────────────────────────┘
        </pre>
        <table class="info-table">
          <tr><td class="key">name</td><td class="sep">:</td><td class="val">Andy.Lee</td></tr>
          <tr><td class="key">role</td><td class="sep">:</td><td class="val">Embedded/Linux/Android Engineer · TPM · Team Leader</td></tr>
          <tr><td class="key">location</td><td class="sep">:</td><td class="val">Chengdu, China</td></tr>
          <tr><td class="key">org</td><td class="sep">:</td><td class="val">Siemens</td></tr>
          <tr><td class="key">email</td><td class="sep">:</td><td class="val"><a href="mailto:huaqianlee@gmail.com">huaqianlee@gmail.com</a></td></tr>
          <tr><td class="key">exp</td><td class="sep">:</td><td class="val">10+ years (since 2011)</td></tr>
          <tr><td class="key">education</td><td class="sep">:</td><td class="val">Sichuan Technology and Business University · Electronic Information Engineering</td></tr>
          <tr><td class="key">status</td><td class="sep">:</td><td class="val"><span class="green">●</span> <span class="dim">building things</span></td></tr>
        </table>
      </div>

      <div class="gap"></div>

      <!-- ls projects/ -->
      <div class="cmd-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cmd">ls -la projects/</span>
      </div>
      <div class="output">
        <pre class="ls-output"><span class="dim">total 32</span>
<span class="cyan">drwxr-xr-x</span>  <span class="magenta">android/</span>  <span class="dim">Android kernel &amp; system programming</span>
<span class="cyan">drwxr-xr-x</span>  <span class="magenta">linux/</span>     <span class="dim">Linux driver &amp; embedded development</span>
<span class="cyan">drwxr-xr-x</span>  <span class="magenta">uav/</span>       <span class="dim">UAV &amp; drone software</span>
<span class="cyan">-rw-r--r--</span>  <span class="blue">blog/</span>      <span class="dim">→ <a href="/blog/">/blog</a>  (125+ posts)</span></pre>
      </div>

      <div class="gap"></div>

      <!-- Navigation -->
      <div class="cmd-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cmd">help</span>
      </div>
      <div class="output">
        <pre class="help-output">Available commands:

  <a href="/about/">about</a>        <span class="dim">— About me</span>
  <a href="/projects/">projects</a>     <span class="dim">— Project portfolio</span>
  <a href="/blog/">blog</a>         <span class="dim">— Blog → /blog</span>
  <a href="https://github.com/huaqianlee">github</a>      <span class="dim">— GitHub profile</span></pre>
      </div>

      <div class="gap"></div>

      <!-- Prompt -->
      <div class="cmd-line" id="cursor-line">
        <span class="prompt"><span class="cyan">huaqianlee</span><span class="dim">@</span><span class="green">github</span><span class="dim">:</span><span class="blue">~</span><span class="dim">$</span></span>
        <span class="cursor blink">_</span>
      </div>

      <!-- Footer -->
      <footer class="footer">
        <span class="dim">[</span><a href="https://github.com/huaqianlee">github</a><span class="dim">]</span>
        <span class="dim">[</span><a href="mailto:huaqianlee@gmail.com">email</a><span class="dim">]</span>
        <span class="dim">[</span><span class="green">● online</span><span class="dim">]</span>
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  /* index-specific — shared terminal utilities live in Layout.astro */
  .boot { font-size: .82rem; color: var(--c-dim); line-height: 1.6; }
  .boot .ok { color: var(--c-green); font-weight: 500; }

  .info-table { border-collapse: collapse; }
  .info-table .key { color: var(--c-yellow); padding-right: .6rem; vertical-align: top; white-space: nowrap; }
  .info-table .sep { color: var(--c-dim); padding-right: .6rem; }
  .info-table .val { color: var(--fg); }

  .ascii-name { color: var(--c-cyan); font-size: .7rem; line-height: 1.15; margin-bottom: .5rem; }
  .ls-output { line-height: 1.8; font-size: .9rem; }
  .help-output { line-height: 2; }
  .help-output a { color: var(--fg); }
  .help-output a:hover { color: var(--c-cyan); }

  /* Blinking cursor */
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .blink { animation: blink 1.2s step-end infinite; }
  .cursor { color: var(--c-green); font-weight: 700; }

  .footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-sm);
    display: flex; gap: 1rem;
  }

  @media (max-width: 600px) {
    .ascii-name { font-size: .5rem; }
  }
</style>
